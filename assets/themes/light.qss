/*
 * Mobile-Diag-Pro — Tema Claro (macOS-inspired)
 *
 * Paleta de cores sóbria e elegante inspirada no macOS Light Mode.
 *
 * Cores principais:
 *   Background    #f5f5f7
 *   Surface       #ffffff
 *   Elevated      #e5e5ea
 *   Separator     #d1d1d6
 *   Accent        #007aff
 *   Text Primary  #1d1d1f
 *   Text Second.  #86868b
 *   Success       #34c759
 *   Warning       #ff9500
 *   Danger        #ff3b30
 *   Sidebar       #e8e8ed
 */

/* ─── Base ─── */
QMainWindow, QWidget {
    background-color: #f5f5f7;
    color: #1d1d1f;
    font-family: "SF Pro Display", "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
}

QMainWindow {
    border: 1px solid #e5e5ea;
}

/* ─── Labels ─── */
QLabel {
    color: #1d1d1f;
    background: transparent;
}

QLabel[class="secondary"] {
    color: #86868b;
}

/* ─── Botões ─── */
QPushButton {
    background-color: #ffffff;
    color: #1d1d1f;
    border: 1px solid #d1d1d6;
    border-radius: 8px;
    padding: 7px 16px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #e5e5ea;
    border-color: #aeaeb2;
}

QPushButton:pressed {
    background-color: #d1d1d6;
}

QPushButton:disabled {
    background-color: #ffffff;
    color: #aeaeb2;
    border-color: #e5e5ea;
}

QPushButton:focus {
    border-color: #007aff;
}

/* Botão primário (accent) */
QPushButton[class="primary"] {
    background-color: #007aff;
    color: #ffffff;
    border: none;
}

QPushButton[class="primary"]:hover {
    background-color: #3395ff;
}

QPushButton[class="primary"]:pressed {
    background-color: #0062cc;
}

/* ─── Campos de texto ─── */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #ffffff;
    color: #1d1d1f;
    border: 1px solid #d1d1d6;
    border-radius: 8px;
    padding: 6px 10px;
    selection-background-color: #007aff;
    selection-color: #ffffff;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #007aff;
}

QLineEdit:disabled, QTextEdit:disabled {
    background-color: #f5f5f7;
    color: #aeaeb2;
}

/* ─── ScrollBar Vertical ─── */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 8px;
    margin: 4px 2px;
}

QScrollBar::handle:vertical {
    background: #d1d1d6;
    min-height: 32px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #aeaeb2;
}

QScrollBar::handle:vertical:pressed {
    background: #86868b;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    border: none;
    background: none;
    height: 0px;
}

/* ─── ScrollBar Horizontal ─── */
QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 8px;
    margin: 2px 4px;
}

QScrollBar::handle:horizontal {
    background: #d1d1d6;
    min-width: 32px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: #aeaeb2;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    border: none;
    background: none;
    width: 0px;
}

/* ─── Barra de progresso ─── */
QProgressBar {
    border: none;
    border-radius: 4px;
    text-align: center;
    color: #1d1d1f;
    background-color: #e5e5ea;
    height: 8px;
    font-size: 11px;
}

QProgressBar::chunk {
    background-color: #007aff;
    border-radius: 4px;
}

/* ─── Tabs ─── */
QTabWidget::pane {
    border: 1px solid #e5e5ea;
    border-radius: 8px;
    background: #ffffff;
    top: -1px;
}

QTabBar::tab {
    background: transparent;
    color: #86868b;
    padding: 8px 20px;
    border-bottom: 2px solid transparent;
    font-weight: 500;
}

QTabBar::tab:hover {
    color: #1d1d1f;
}

QTabBar::tab:selected {
    color: #007aff;
    border-bottom: 2px solid #007aff;
}

/* ─── ComboBox ─── */
QComboBox {
    background-color: #ffffff;
    color: #1d1d1f;
    border: 1px solid #d1d1d6;
    border-radius: 8px;
    padding: 6px 10px;
    min-width: 80px;
}

QComboBox:hover {
    border-color: #aeaeb2;
}

QComboBox:focus {
    border-color: #007aff;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #86868b;
    margin-right: 8px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #1d1d1f;
    border: 1px solid #d1d1d6;
    border-radius: 8px;
    selection-background-color: #007aff;
    selection-color: #ffffff;
    padding: 4px;
}

/* ─── CheckBox & RadioButton ─── */
QCheckBox, QRadioButton {
    color: #1d1d1f;
    spacing: 8px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #aeaeb2;
    border-radius: 4px;
    background: #ffffff;
}

QRadioButton::indicator {
    border-radius: 10px;
}

QCheckBox::indicator:checked {
    background-color: #007aff;
    border-color: #007aff;
}

QRadioButton::indicator:checked {
    background-color: #007aff;
    border-color: #007aff;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #007aff;
}

/* ─── GroupBox ─── */
QGroupBox {
    border: 1px solid #e5e5ea;
    border-radius: 10px;
    margin-top: 12px;
    padding-top: 16px;
    color: #1d1d1f;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 14px;
    padding: 0 6px;
    color: #1d1d1f;
}

/* ─── ToolTip ─── */
QToolTip {
    background-color: #ffffff;
    color: #1d1d1f;
    border: 1px solid #d1d1d6;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}

/* ─── Menu ─── */
QMenuBar {
    background-color: #f5f5f7;
    color: #1d1d1f;
    border-bottom: 1px solid #e5e5ea;
}

QMenuBar::item {
    padding: 4px 12px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #e5e5ea;
}

QMenu {
    background-color: #ffffff;
    color: #1d1d1f;
    border: 1px solid #e5e5ea;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    padding: 6px 32px 6px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #007aff;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #e5e5ea;
    margin: 4px 8px;
}

/* ─── Splitter ─── */
QSplitter::handle {
    background-color: #e5e5ea;
    width: 1px;
}

/* ─── StatusBar ─── */
QStatusBar {
    background-color: #f5f5f7;
    color: #86868b;
    border-top: 1px solid #ffffff;
    font-size: 12px;
    padding: 2px 8px;
}

/* ─── ScrollArea ─── */
QScrollArea {
    border: none;
    background: transparent;
}

/* ══════════════════════════════════════════════
   Classes Customizadas
   ══════════════════════════════════════════════ */

/* ─── Sidebar ─── */
[class="sidebar"] {
    background-color: #e8e8ed;
    border-right: 1px solid #d1d1d6;
}

[class="sidebar-button"] {
    background-color: transparent;
    color: #86868b;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 0px;
    text-align: left;
    padding: 12px 16px;
    font-size: 13px;
    font-weight: 500;
}

[class="sidebar-button"]:hover {
    background-color: #ffffff;
    color: #1d1d1f;
}

[class="sidebar-button-active"] {
    background-color: #ffffff;
    color: #1d1d1f;
    border: none;
    border-left: 3px solid #007aff;
    border-radius: 0px;
    text-align: left;
    padding: 12px 16px;
    font-size: 13px;
    font-weight: 600;
}

[class="sidebar-button-active"]:hover {
    background-color: #e5e5ea;
}

/* ─── Device Card ─── */
[class="device-card"] {
    background-color: #ffffff;
    border-radius: 12px;
    border: 1px solid #e5e5ea;
    padding: 16px;
}

[class="device-card"]:hover {
    border-color: #d1d1d6;
}

/* ─── Status Badge ─── */
[class="status-badge"] {
    border-radius: 12px;
    padding: 4px 12px;
    font-size: 12px;
    font-weight: 600;
}

/* ─── Gauge Widget ─── */
[class="gauge-widget"] {
    background-color: transparent;
}

/* ─── Títulos ─── */
[class="page-title"] {
    font-size: 26px;
    font-weight: 700;
    color: #1d1d1f;
    background: transparent;
}

[class="section-title"] {
    font-size: 17px;
    font-weight: 600;
    color: #1d1d1f;
    background: transparent;
}

/* ─── Cards genéricos ─── */
[class="card"] {
    background-color: #ffffff;
    border-radius: 12px;
    border: 1px solid #e5e5ea;
    padding: 16px;
}

[class="card"]:hover {
    background-color: #e5e5ea;
    border-color: #d1d1d6;
}

/* ─── Toast Notification ─── */
[class="toast-notification"] {
    background-color: #ffffff;
    border: 1px solid #e5e5ea;
    border-radius: 10px;
}

/* ─── Title Bar ─── */
#TitleBar {
    background-color: #e8e8ed;
    border-bottom: 1px solid #d1d1d6;
}

/* --- Title Bar Buttons & Custom Controls --- */
#titleBarBtn {
    background-color: transparent;
    color: #86868b;
    border: none;
    border-radius: 6px;
    font-size: 13px;
}
#titleBarBtn:hover {
    background-color: #e5e5ea;
    color: #1d1d1f;
}
#titleBarCloseBtn {
    background-color: transparent;
    color: #86868b;
    border: none;
    border-radius: 6px;
    font-size: 13px;
}
#titleBarCloseBtn:hover {
    background-color: #ff3b30;
    color: #ffffff;
}
#titleBarActionBtn {
    background-color: #ffffff;
    color: #1d1d1f;
    border: 1px solid #d1d1d6;
    border-radius: 6px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 500;
}
#titleBarActionBtn:hover {
    background-color: #e5e5ea;
    border-color: #aeaeb2;
}
#sidebarSeparator {
    background-color: #d1d1d6;
    border: none;
}
